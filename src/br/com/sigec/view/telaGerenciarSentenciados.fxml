<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.sigec.controller.TelaGerenciarSentenciadosController">
   <children>
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0">
         <children>
            <Label alignment="TOP_CENTER" prefHeight="35.0" prefWidth="650.0" styleClass="form-title" stylesheets="@style.css" text="SENTENCIADOS" />
         </children>
      </HBox>
      <HBox prefHeight="50.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label styleClass="form-label" stylesheets="@style.css" text="Nome ou Matrícula: " />
            <TextField fx:id="txtBusca" />
            <Button fx:id="btnPesquisar" mnemonicParsing="false" onAction="#pesquisar" prefHeight="35.0" prefWidth="105.0" styleClass="search-button" stylesheets="@style.css" text="Pesquisar" />
         </children>
      </HBox>
      <TableView fx:id="tabelaSentenciados" prefHeight="330.0" prefWidth="200.0" styleClass="exam-table" stylesheets="@style.css">
        <columns>
          <TableColumn fx:id="colMatricula" prefWidth="150.0" text="Matrícula" />
          <TableColumn fx:id="colNome" prefWidth="450.0" text="Nome" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" prefHeight="70.0" prefWidth="200.0" spacing="15.0" stylesheets="@style.css">
         <children>
            <Button fx:id="btnNovo" mnemonicParsing="false" onAction="#novoSentenciado" prefHeight="10.0" prefWidth="140.0" styleClass="form-button" stylesheets="@style.css" text="NOVO" />
            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editarSentenciado" prefHeight="10.0" prefWidth="140.0" styleClass="secondary-button" stylesheets="@style.css" text="EDITAR" />
         </children>
      </HBox>
   </children>
</VBox>
