<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.sigec.controller.TelaGerenciarProfissionaisController">
   <children>
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0">
         <children>
            <Label alignment="TOP_CENTER" prefHeight="35.0" prefWidth="750.0" styleClass="form-title" stylesheets="@style.css" text="PROFISSIONAIS" />
         </children>
      </HBox>
      <HBox prefHeight="50.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label styleClass="form-label" stylesheets="@style.css" text="Nome: " />
            <TextField fx:id="txtNome" />
            <Label styleClass="form-label" stylesheets="@style.css" text="Tipo: " />
            <ComboBox fx:id="cbFiltroTipo" prefWidth="180.0" promptText="Todos" />
            <Label styleClass="form-label" stylesheets="@style.css" text="Status: " />
            <ComboBox fx:id="cbFiltroAtivo" prefWidth="120.0" promptText="Todos" />
            <Button fx:id="btnPesquisar" mnemonicParsing="false" onAction="#pesquisar" prefHeight="35.0" prefWidth="105.0" styleClass="search-button" stylesheets="@style.css" text="Pesquisar" />
         </children>
      </HBox>
      <TableView fx:id="tabelaProfissionais" prefHeight="300.0" prefWidth="200.0" styleClass="exam-table" stylesheets="@style.css">
        <columns>
          <TableColumn fx:id="colNome" prefWidth="300.0" text="Nome" />
          <TableColumn fx:id="colTipo" prefWidth="220.0" text="Tipo" />
          <TableColumn fx:id="colAtivo" prefWidth="130.0" text="Status" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" prefHeight="70.0" prefWidth="200.0" spacing="15.0" stylesheets="@style.css">
         <children>
            <Button fx:id="btnNovo" mnemonicParsing="false" onAction="#novoProfissional" prefHeight="10.0" prefWidth="140.0" styleClass="form-button" stylesheets="@style.css" text="NOVO" />
            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editarProfissional" prefHeight="10.0" prefWidth="140.0" styleClass="secondary-button" stylesheets="@style.css" text="EDITAR" />
            <Button fx:id="btnAlternarStatus" mnemonicParsing="false" onAction="#alternarStatus" prefHeight="10.0" prefWidth="180.0" styleClass="danger-button" stylesheets="@style.css" text="ATIVAR / INATIVAR" />
         </children>
      </HBox>
   </children>
</VBox>
