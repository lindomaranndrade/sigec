<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.sigec.controller.NovoPedidoController"
            stylesheets="@styles.css"
            styleClass="root-pane"
            prefWidth="520">

    <!-- ===================== Topo ===================== -->
    <top>
        <VBox styleClass="top-bar">
            <padding>
                <Insets top="20" right="24" bottom="16" left="24"/>
            </padding>
            <Label text="Novo pedido de exame" styleClass="screen-title"/>
        </VBox>
    </top>

    <!-- ===================== Centro: formulário ===================== -->
    <center>
        <VBox spacing="18" styleClass="content-area">
            <padding>
                <Insets top="20" right="24" bottom="16" left="24"/>
            </padding>

            <!-- Pesquisa de sentenciado -->
            <VBox spacing="6">
                <Label text="Matrícula do sentenciado" styleClass="field-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="txtMatricula" promptText="Ex.: 123456" styleClass="search-field" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnPesquisarSentenciado" text="Pesquisar sentenciado" styleClass="btn-secondary" onAction="#handlePesquisarSentenciado"/>
                </HBox>
            </VBox>

            <VBox spacing="6">
                <Label text="Nome do sentenciado" styleClass="field-label"/>
                <TextField fx:id="txtNomeSentenciado" editable="false" styleClass="search-field" promptText="Preenchido após a pesquisa"/>
            </VBox>

            <GridPane hgap="16" vgap="6">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <Label text="Número do processo" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label text="Data da solicitação" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <TextField fx:id="txtNumeroProcesso" promptText="0000000-00" styleClass="search-field"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpDataSolicitacao" styleClass="search-field"
                            GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>
            </GridPane>

            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Label text="Benefícios" styleClass="field-label"/>
                <ListView fx:id="listViewBeneficios" styleClass="modern-table" prefHeight="160"/>
                <Label text="Selecione um ou mais benefícios (Ctrl/Shift + clique)" styleClass="alert-label"/>
            </VBox>

        </VBox>
    </center>

    <!-- ===================== Rodapé ===================== -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="action-bar">
            <padding>
                <Insets top="14" right="24" bottom="18" left="24"/>
            </padding>
            <Button fx:id="btnCancelar" text="Cancelar" styleClass="btn-ghost" onAction="#handleCancelar"/>
            <Button fx:id="btnSalvar" text="Salvar pedido" styleClass="btn-primary" onAction="#handleSalvar"/>
        </HBox>
    </bottom>

</BorderPane>
