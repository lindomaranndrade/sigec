<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.sigec.controller.MainController"
            stylesheets="@styles.css"
            styleClass="root-pane">

    <!-- ===================== TOPO: título + pesquisa ===================== -->
    <top>
        <VBox spacing="12" styleClass="top-bar">
            <padding>
                <Insets top="20" right="24" bottom="16" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="SIGEC — Pedidos de exame" styleClass="screen-title"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtPesquisaMatricula"
                           promptText="Buscar por matrícula"
                           styleClass="search-field"
                           prefWidth="220"/>
                <Button fx:id="btnPesquisar"
                        text="Pesquisar"
                        styleClass="btn-secondary"
                        onAction="#handlePesquisar"/>
            </HBox>

            <!-- Área de alerta de reiterações -->
            <HBox fx:id="alertBox"
                  alignment="CENTER_LEFT"
                  spacing="8"
                  styleClass="alert-box"
                  visible="false"
                  managed="false">
                <Label fx:id="lblAlertaReiteracoes" styleClass="alert-label"/>
            </HBox>
        </VBox>
    </top>

    <!-- ===================== CENTRO: tabela de pedidos ===================== -->
    <center>
        <VBox styleClass="content-area">
            <padding>
                <Insets top="0" right="24" bottom="16" left="24"/>
            </padding>

            <TableView fx:id="tableViewPedidos" styleClass="modern-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="110"/>
                    <TableColumn fx:id="colNomeSentenciado" text="Nome do sentenciado" prefWidth="260"/>
                    <TableColumn fx:id="colNumeroProcesso" text="Número do processo" prefWidth="180"/>
                    <TableColumn fx:id="colDataSolicitacao" text="Data da solicitação" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- ===================== RODAPÉ: ações ===================== -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="action-bar">
            <padding>
                <Insets top="14" right="24" bottom="18" left="24"/>
            </padding>

            <Button fx:id="btnNovoPedido" text="Novo pedido" styleClass="btn-primary" onAction="#handleNovoPedido"/>
            <Button fx:id="btnAbrirPedido" text="Abrir pedido" styleClass="btn-secondary" onAction="#handleAbrirPedido"/>
            <Button fx:id="btnRegistrarEntrevista" text="Registrar entrevista" styleClass="btn-secondary" onAction="#handleRegistrarEntrevista"/>
            <Button fx:id="btnRegistrarReiteracao" text="Registrar reiteração" styleClass="btn-secondary" onAction="#handleRegistrarReiteracao"/>
            <Button fx:id="btnConcluirPedido" text="Concluir pedido" styleClass="btn-secondary" onAction="#handleConcluirPedido"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblPedidosReiterados"
                   text="Pedidos reiterados na lista: 0"
                   styleClass="reiteration-indicator"
                   onMouseClicked="#handleFiltrarReiterados"/>
            <Button fx:id="btnAtualizar" text="Atualizar" styleClass="btn-ghost" onAction="#handleAtualizar"/>
        </HBox>
    </bottom>

</BorderPane>
