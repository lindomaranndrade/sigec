<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.sigec.controller.TelaFilaAtendimentosController">
   <children>
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0">
         <children>
            <Label alignment="TOP_CENTER" prefHeight="35.0" prefWidth="750.0" styleClass="form-title" stylesheets="@style.css" text="FILA DE ATENDIMENTOS" />
         </children>
      </HBox>
      <HBox prefHeight="50.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label styleClass="form-label" stylesheets="@style.css" text="Matrícula: " />
            <TextField fx:id="txtMatricula" />
            <Label styleClass="form-label" stylesheets="@style.css" text="Status: " />
            <ComboBox fx:id="cbStatus" prefWidth="180.0" />
            <Button fx:id="btnPesquisar" mnemonicParsing="false" onAction="#pesquisar" prefHeight="35.0" prefWidth="105.0" styleClass="search-button" stylesheets="@style.css" text="Pesquisar" />
         </children>
      </HBox>
      <TableView fx:id="tabelaFila" prefHeight="330.0" prefWidth="200.0" styleClass="exam-table" stylesheets="@style.css">
        <columns>
          <TableColumn fx:id="colMatricula" prefWidth="90.0" text="Matrícula" />
          <TableColumn fx:id="colNome" prefWidth="200.0" text="Nome" />
          <TableColumn fx:id="colTipoAtendimento" prefWidth="140.0" text="Tipo de Atendimento" />
          <TableColumn fx:id="colProfissional" prefWidth="130.0" text="Profissional" />
          <TableColumn fx:id="colDataAgendamento" prefWidth="110.0" text="Data Agendada" />
          <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" prefHeight="70.0" prefWidth="200.0" spacing="15.0" stylesheets="@style.css">
         <children>
            <Button fx:id="btnAgendar" mnemonicParsing="false" onAction="#agendar" prefHeight="10.0" prefWidth="140.0" styleClass="form-button" stylesheets="@style.css" text="AGENDAR" />
            <Button fx:id="btnRegistrarRealizacao" mnemonicParsing="false" onAction="#registrarRealizacao" prefHeight="10.0" prefWidth="180.0" styleClass="secondary-button" stylesheets="@style.css" text="REGISTRAR REALIZAÇÃO" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" prefHeight="10.0" prefWidth="120.0" styleClass="danger-button" stylesheets="@style.css" text="CANCELAR" />
         </children>
      </HBox>
   </children>
</VBox>
