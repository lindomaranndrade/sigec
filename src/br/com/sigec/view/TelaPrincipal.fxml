<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="BorderPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.sigec.controller.TelaPrincipalController">
   <top>
      <HBox fx:id="header" maxHeight="64.0" minHeight="64.0" prefHeight="64.0" prefWidth="200.0" styleClass="header" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblSistema" styleClass="system-title" text="SIGEC" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <HBox spacing="10.0">
               <children>
                  <Label fx:id="lblUsuario" styleClass="user-label" text="Usuário: Lindomar" />
                  <Hyperlink fx:id="lnkAlterarSenha" onAction="#abrirAlterarSenha" styleClass="change-password-link" stylesheets="@style.css" text="Alterar Senha" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <left>
      <VBox fx:id="menuLateral" maxWidth="240.0" minWidth="240.0" prefHeight="200.0" prefWidth="240.0" styleClass="menu-lateral" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <Button
                    fx:id="btnInicio"
                    mnemonicParsing="false"
                    onAction="#abrirExamesPendentes"
                    prefHeight="50.0"
                    stylesheets="@style.css"
                    text="Inicio"
                    styleClass="menu-button" />
            <Button
                    fx:id="btnFila"
                    mnemonicParsing="false"
                    onAction="#abrirFilaAtendimentos"
                    prefHeight="50.0"
                    stylesheets="@style.css"
                    text="Fila de Atendimentos"
                    styleClass="menu-button" />
            <Button mnemonicParsing="false" styleClass="menu-button" stylesheets="@style.css" text="Sentenciados" />
            <Button fx:id="btnUsuarios" mnemonicParsing="false" onAction="#abrirUsuarios" styleClass="menu-button" text="Usuarios" />
            <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
            <Button fx:id="btnSair" mnemonicParsing="false" onAction="#sair" styleClass="exit-button" text="Sair">
               <graphic>
                  <ImageView fitHeight="38.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/btnSair.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" prefHeight="150.0" prefWidth="200.0" styleClass="content-area" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="formContainer" prefHeight="200.0" prefWidth="100.0" styleClass="form-container" stylesheets="@style.css">
               <StackPane.margin>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </StackPane.margin>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
