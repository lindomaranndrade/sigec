<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.sigec.controller.TelaExamesPendentesController">
   <children>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label alignment="TOP_CENTER" prefHeight="35.0" prefWidth="607.0" styleClass="form-title" stylesheets="@style.css" text="EXAMES">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <padding>
                  <Insets bottom="15.0" />
               </padding></Label>
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label styleClass="form-label" stylesheets="@style.css" text="Matrícula: " />
            <TextField fx:id="txtMatricula" />
            <Label styleClass="form-label" stylesheets="@style.css" text="Status: " />
            <ComboBox fx:id="cbStatus" onAction="#pesquisar" prefWidth="150.0" />
            <Button fx:id="btnPesquisar" mnemonicParsing="false" onAction="#pesquisar" prefHeight="35.0" prefWidth="105.0" styleClass="search-button" stylesheets="@style.css" text="Pesquisar" />
         </children>
      </HBox>
      <TableView fx:id="tabelaExames" prefHeight="380.0" prefWidth="200.0" styleClass="exam-table" stylesheets="@style.css">
        <columns>
          <TableColumn fx:id="colMatricula" prefWidth="93.60003662109375" text="Matrícula" />
          <TableColumn fx:id="colNome" prefWidth="273.5999755859375" text="Nome" />
            <TableColumn fx:id="colTipoBeneficio" prefWidth="112.0" text="Beneficio" />
            <TableColumn fx:id="colData" prefWidth="120.79998779296875" text="Data da Solicitação" />
            <TableColumn fx:id="colPsicologo" prefWidth="140.0" text="Psicólogo" />
            <TableColumn fx:id="colAssistenteSocial" prefWidth="140.0" text="Assistente Social" />
            <TableColumn fx:id="colProntoParaConcluir" prefWidth="150.0" text="Situação" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0" stylesheets="@style.css">
         <children>
            <Button fx:id="btnNovo" mnemonicParsing="false" onAction="#novoPedido" prefHeight="10.0" prefWidth="120.0" styleClass="form-button" stylesheets="@style.css" text="NOVO" />
            <Button fx:id="btnAtender" mnemonicParsing="false" onAction="#atender" prefHeight="10.0" prefWidth="120.0" styleClass="form-button" stylesheets="@style.css" text="ATENDER" />
            <Button fx:id="btnReiterar" mnemonicParsing="false" onAction="#reiterar" prefHeight="10.0" prefWidth="120.0" styleClass="form-button" stylesheets="@style.css" text="REITERAR" />
         </children>
      </HBox>
   </children>
</VBox>
