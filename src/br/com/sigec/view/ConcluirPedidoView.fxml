<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.sigec.controller.ConcluirPedidoController"
            stylesheets="@styles.css"
            styleClass="root-pane"
            prefWidth="520">
    <top>
        <VBox spacing="6" styleClass="top-bar">
            <padding>
                <Insets top="20" right="24" bottom="16" left="24"/>
            </padding>
            <Label text="Concluir pedido" styleClass="screen-title"/>
            <Label fx:id="lblPedido" styleClass="field-label"/>
            <Label fx:id="lblSentenciado" styleClass="field-label"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="8" styleClass="content-area">
            <padding>
                <Insets top="20" right="24" bottom="16" left="24"/>
            </padding>
            <Label text="Número SEI" styleClass="field-label"/>
            <TextField fx:id="txtNumeroSei" promptText="Informe o número SEI" styleClass="search-field"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="action-bar">
            <padding>
                <Insets top="14" right="24" bottom="18" left="24"/>
            </padding>
            <Button text="Cancelar" styleClass="btn-ghost" onAction="#handleCancelar"/>
            <Button text="Concluir pedido" styleClass="btn-primary" onAction="#handleConcluir"/>
        </HBox>
    </bottom>
</BorderPane>
